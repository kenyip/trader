# Quality worker sprint profile — EDGE throughput for multi-day push.
# Sourced by scripts/trader_quality_worker.sh and `just trader-quality-worker`.
# Never enables live/arm.

# Seconds between cycles (was 20)
TRADER_QUALITY_SLEEP=5

# Parallel prove slots (M4 10-core; phase uses ≤4 subprocesses)
TRADER_QC_PARALLEL=4

# When paper book is full (2/2), skip heavy campaign most cycles (~200s each).
# Always campaign when book has room for a new open.
TRADER_QC_PAPER_EVERY=3
TRADER_QC_CAMPAIGN_EVERY=3

# Slightly wider CSP search (first-live MCP lane) + stress batch
TRADER_QC_TOP_CSP=8
TRADER_QC_MUT_CSP=2
TRADER_QC_TOP_DR=8
TRADER_QC_MUT_DR=3
TRADER_QC_STRESS_LIMIT=8
TRADER_QC_STRESS_LEADERS=2

# Stress selector: longer leader TTL + low-ok-rate toxic (NFLX CCS thrash fix 2026-07-28)
TRADER_QC_LEADER_TTL_HOURS=48
TRADER_QC_TOXIC_MAX_OK_RATE=0.05

# Registry thrash guard (2026-07-28 coach): skip evolve --apply when yaml bloated;
# alternate one evolve lane/cycle when healthy (DR odd / CSP even).
# 2026-07-28T2100: lower bloat ceiling — 5MB/1.2k hyps already starved stress queue
# with thin NEEDS creates; trip skip sooner and force prune off-hours.
TRADER_QC_REGISTRY_MAX_BYTES=6000000
TRADER_QC_EVOLVE_LANES=one
# Only register dense SHIP (n>=6 enforced in apply_results); cap creates/cycle.
TRADER_QC_SHIP_ONLY=1
TRADER_QC_MAX_CREATE=2

# Safety
TRADER_QC_FORCE_PAPER=0
